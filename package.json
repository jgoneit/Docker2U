{
  "name": "docker2u",
  "private": true,
  "version": "0.1.0-alpha.1",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "icons": "tauri icon assets/app-icon.svg --output src-tauri/gen/icons",
    "rust:fmt": "node scripts/with-toolchain.mjs cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:test": "pnpm icons && node scripts/with-toolchain.mjs cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "tauri": "tauri",
    "native:dev": "node scripts/with-toolchain.mjs pnpm exec tauri dev",
    "native:build": "node scripts/with-toolchain.mjs pnpm exec tauri build --bundles app"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
